# Local development only. Set an address that controls the PactAccount.
PACT_PRINCIPAL=0x0000000000000000000000000000000000000001
# Set ETH_RPC_URL and a deployer key only in a private local environment when broadcasting.

# Service configuration; use local disposable accounts, contracts and database.
PACT_DATABASE_URL=postgres://postgres:pact_local_only@127.0.0.1:5432/pact
PACT_RPC_URL=http://127.0.0.1:8545
PACT_CHAIN_ID=31337
PACT_REGISTRY=0x0000000000000000000000000000000000000000
PACT_LEDGER=0x0000000000000000000000000000000000000000
PACT_ACCOUNT=0x0000000000000000000000000000000000000000
PACT_MANAGER=0x0000000000000000000000000000000000000000
PACT_VAULT=0x0000000000000000000000000000000000000000
PACT_RECEIPTS=0x0000000000000000000000000000000000000000
PACT_AUTH_DOMAIN=localhost
PACT_ENVIRONMENT=development
PACT_CONSOLE_ORIGIN=http://localhost:5173
PACT_EXPLORER_ORIGIN=http://localhost:5174
PACT_FINALITY_BLOCKS=5
PACT_INDEXER_START_BLOCK=0
PACT_SESSION_TTL_SECONDS=3600
# Browser build values. Privy App ID is public; enable wallet login by setting it.
VITE_PACT_API_URL=http://127.0.0.1:4100
# Optional during migration: route legacy /v1 grants and Explorer reads to the original API.
VITE_PACT_LEGACY_API_URL=
VITE_PRIVY_APP_ID=
# Production gateway uses Secrets Manager; set this to a secret ARN/name, never the token.
PACT_GITHUB_SECRET_ID=
# Production API uses a private S3 bucket and a customer-managed KMS key.
PACT_EVIDENCE_BUCKET=
PACT_EVIDENCE_KMS_KEY_ID=
PACT_CREDENTIAL_KMS_KEY_ID=
# Optional, unaudited testnet-only Pact-funded model credits. Token must have 6 decimals.
PACT_BILLING_TOKEN=
PACT_BILLING_TREASURY=
# Exact approved model rates: micro-USD per million input/output tokens.
PACT_MODEL_PRICES_JSON=
# Secrets Manager IDs for Pact-funded OpenAI, Anthropic, or custom model access.
PACT_OPENAI_SECRET_ID=
PACT_ANTHROPIC_SECRET_ID=
PACT_CUSTOM_MODEL_SECRET_ID=
# Comma-separated exact HTTPS URLs approved for custom OpenAI-compatible models.
PACT_CUSTOM_MODEL_ENDPOINTS=
# Optional read-only operations monitor thresholds.
PACT_HEARTBEAT_MAX_AGE_SECONDS=30
PACT_MAX_INDEXER_LAG_BLOCKS=20
# The MCP server reads PACT_API_URL and a short-lived PACT_SESSION_TOKEN.
