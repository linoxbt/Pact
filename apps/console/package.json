{
  "name": "@pact/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build --emptyOutDir",
    "check": "tsc -p tsconfig.json --noEmit",
    "deploy:cloudflare": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@pact/abis": "workspace:*",
    "@pact/policies": "workspace:*",
    "@pact/sdk-ts": "workspace:*",
    "@privy-io/react-auth": "3.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  }
}
